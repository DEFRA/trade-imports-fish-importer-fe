{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <p class="govuk-body">This temporary, read-only page shows the ENVIRONMENT variable supplied to the running frontend. It does not infer a value from NODE_ENV or the URL.</p>

      {{ govukSummaryList({
        rows: [
          { key: { text: "ENVIRONMENT" }, value: { text: environment } }
        ]
      }) }}
    </div>
  </div>
{% endblock %}
